<Window x:Class="ShoesStore_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Окно авторизации" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Photos/Icon.JPG">
    <Grid>
        <StackPanel Orientation="Vertical" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <Border Background="#7FFF00" CornerRadius="10" Margin="0,0,0,40" Padding="20,10" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Photos/Icon.png" Width="50" Height="50" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Авторизация" FontFamily="Times New Roman" FontSize="33" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Логин: " FontFamily="Times New Roman" Width="50" VerticalAlignment="Center"/>
                    <TextBox Width="255" Height="25" Name="LoginBox"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Пароль: " FontFamily="Times New Roman" Width="50" VerticalAlignment="Center"/>
                    <PasswordBox Width="255" Height="25" Name="PasswordBox"/>
                </StackPanel>

                <Button Content="Войти" Name="Login" Click="Login_Click" FontFamily="Times New Roman" Width="300" Height="30" Margin="5"/>
                <Button Content="Войти как гость" FontFamily="Times New Roman" Name="GuestVhod" Width="200" Height="30" Margin="5" Click="GuestVhod_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
