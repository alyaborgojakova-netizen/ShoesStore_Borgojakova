<Window x:Class="ShoesStore_.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Окно с товарами" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Photos/Icon.JPG">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="2">
            <Button Width="150" Height="20" Content="На главный экран" FontFamily="Times New Roman" Background="#7FFF00" Name="BackToMainWindow" Click="BackToMainWindow_Click"/>
            <TextBlock Width="50" Height="20" Text="Гость" FontFamily="Times New Roman"/>
        </StackPanel>
       
        <ListView Name="ListTovar" Margin="0,25,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <Image Source="{Binding Photo}" Margin="10" Width="120"/>
                            </Border>
                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Categories.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                        <TextBlock Text=" | " FontWeight="Bold" FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding ProductTypes.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Description}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Manufacturer.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Suppliers.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Price}" FontWeight="Bold" FontFamily="Times New Roman">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="{Binding price_discount, StringFormat=Новая цена: {0} руб.}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Measurement}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding QuantityInStock}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <TextBlock Text="{Binding Sale}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Times New Roman"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
