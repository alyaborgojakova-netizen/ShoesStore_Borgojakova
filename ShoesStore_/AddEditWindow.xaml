<Window x:Class="ShoesStore_.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Управление товаром" Height="575" Width="800"
        Icon="/Photos/Icon.JPG">
    <StackPanel>

        <Border Background="#7FFF00" Padding="10">
            <TextBlock Text="Управление товаром" FontFamily="Times New Roman" FontSize="26" Foreground="Black" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,6" Name="IdProductPanel" Visibility="Hidden">
            <TextBlock Text="Id" Width="10" FontFamily="Times New Roman" VerticalAlignment="Center" Margin="5"/>
            <TextBox Name="Id_Product" FontFamily="Times New Roman" Text="{Binding Id}" Width="20" Height="20" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0">
                <TextBlock Text="Фото товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Image Name="SourcePhoto" Source="{Binding Photo}" Width="60" Height="45"  Margin="0,0,5,45" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <Button Content="Выбрать изображение" FontFamily="Times New Roman" Width="170" Height="24" Name="ChooseImage" Click="ChooseImage_Click"/>
                    <TextBox Name="TxbPhotoPath" FontFamily="Times New Roman" Text="{Binding Photo}" Width="170" Height="22" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Наименование товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbProduct" FontFamily="Times New Roman" SelectedItem="{Binding Products}" DisplayMemberPath="Article" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Категория товара" FontFamily="Times New Roman" Width="220"  VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbCategory" FontFamily="Times New Roman" SelectedItem="{Binding Categories}" DisplayMemberPath="Name" Width="170" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Описание товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxbDescription" FontFamily="Times New Roman" Text="{Binding Description}" Width="170" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Производитель товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbManufacturer" FontFamily="Times New Roman" SelectedItem="{Binding Manufacturer}" DisplayMemberPath="Name"  Width="170" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Поставщик товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbSupplier" FontFamily="Times New Roman" SelectedItem="{Binding Suppliers}" DisplayMemberPath="Name" Width="170" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Цена товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxbPrice" FontFamily="Times New Roman" Text="{Binding Price}" Width="170" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Единица измерения товара" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxbbMeasure" FontFamily="Times New Roman" Text="{Binding Measurement}" Width="170" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Количество товара на складе" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxbQuantity" FontFamily="Times New Roman" Text="{Binding QuantityInStock}" Width="170" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Действующая скидка" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxbSale" FontFamily="Times New Roman" Text="{Binding Sale}" Width="170" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
            </StackPanel>

            <Button Content="Сохранить данные" FontFamily="Times New Roman" Name="Save" Click="Save_Click"  Width="170" Height="28"  Margin="0,20,0,0" HorizontalAlignment="Center"/>

        </StackPanel>
    </StackPanel>
</Window>
