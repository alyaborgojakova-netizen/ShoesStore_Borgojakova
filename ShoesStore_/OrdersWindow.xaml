<Window x:Class="ShoesStore_.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Окно заказов" Height="450" Width="800"
        Icon="/Photos/Icon.JPG">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="2">
            <Button Margin="5" Width="150" Height="20" Content="Назад" FontFamily="Times New Roman" Background="#7FFF00" Name="BackTo" Click="BackTo_Click"/>
        </StackPanel>
        <StackPanel Name="ButtonPanel" Orientation="Horizontal" VerticalAlignment="Top" Margin="2">
            <Button Margin="5" Width="150" Height="20" Content="Добавить заказ" FontFamily="Times New Roman" Background="#7FFF00" Name="AddOrder" Click="AddOrder_Click"/>
            <Button Margin="5" Width="150" Height="20" Content="Удалить заказ" FontFamily="Times New Roman" Background="#7FFF00" Name="DeleteOrder" Click="DeleteOrder_Click"/>
        </StackPanel>

       
        <ListView MouseDoubleClick="ListOrder_MouseDoubleClick" Name="ListOrder" Margin="0,25,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="600"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Артикул: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding Products.Article}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Статус заказа: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding OrderStatus.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Адрес ПВЗ: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding PVZ.Address}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                       
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Дата заказа: " FontFamily="Times New Roman"/>
                                        <TextBlock Text="{Binding OrderDate}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <TextBlock Text="{Binding DeliveryDate}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontWeight="Bold" FontFamily="Times New Roman"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
