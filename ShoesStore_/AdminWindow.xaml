<Window x:Class="ShoesStore_.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Окно администратора" Height="450" Width="800"
        Icon="/Photos/Icon.JPG">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button  Name="BackToMainWindow"  Content="На главный экран" Width="96" Height="25" FontFamily="Times New Roman" Click="BackToMainWindow_Click"/>
                    <Button  Margin="5,0,0,0" Name="AddProduct" Content="Добавить товар" Width="95" Height="25" FontFamily="Times New Roman" Click="AddProduct_Click"/>
                    <Button Margin="5 0 0 0" Name="DeleteItems" Content="Удалить товары" Width="95" Height="25" FontFamily="Times New Roman" Click="DeleteItems_Click"/>
                    <Button  Margin="5,0,0,0" Name="OrdersBtn" Content="Заказы" Width="70" Height="25" FontFamily="Times New Roman" Click="OrdersBtn_Click"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Photos/Icon.png" Width="40" Height="40" Margin="0,0,10,0"/>
                    <TextBlock Text="Обувь" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Name="fullname"  FontFamily="Times New Roman" FontSize="16" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#7FFF00" Padding="10" Margin="0,2,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" FontFamily="Times New Roman" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Name="SearchBox" Width="150" Height="25" TextChanged="SearchBox_TextChanged"  VerticalContentAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1"
                        Margin="5 5" Width="auto" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Сортировка (по кол-ву на складе)" FontFamily="Times New Roman" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button Name="SortAscBtn" Content="По возрастанию" Click="SortAscBtn_Click"  Margin="0,0,5,0" FontFamily="Times New Roman"/>
                            <Button Name="SortDescBtn" Content="По убыванию" Click="SortDescBtn_Click"  FontFamily="Times New Roman"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поставщик:" FontFamily="Times New Roman" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Name="SupplierFilter" Width="150" Height="25" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SupplierFilter_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Сбросить фильтры" Name="ResetFiltersBtn" Click="ResetFiltersBtn_Click"  Padding="10,5" Margin="15,0,0,0" FontFamily="Times New Roman" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ListView Grid.Row="2" Name="ListTovar" Margin="5" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ListTovar_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="2"
                    Margin="5" Padding="5" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Height="120" Width="120"  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Photo}" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Categories.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                    <TextBlock Text=" | " FontWeight="Bold" FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding ProductTypes.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Описание товара: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding Description}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Производитель: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding Manufacturer.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Поставщик: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding Suppliers.Name}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding Price}" FontWeight="Bold" FontFamily="Times New Roman">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="5,0,0,0"
                                       Text="{Binding price_discount, StringFormat=Новая цена: {0} руб.}"
                                       FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Единица измерения: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding Measurement}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Количество на складе: " FontFamily="Times New Roman"/>
                                    <TextBlock Text="{Binding QuantityInStock}" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="70">
                                <TextBlock Text="{Binding Sale}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Times New Roman"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
