<Window x:Class="ShoesStore_.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoesStore_"
        mc:Ignorable="d"
        Title="Управление заказами" Height="450" Width="800"
        Icon="/Photos/Icon.JPG">
    <StackPanel>

        <Border Background="#7FFF00" Padding="10">
            <TextBlock Text="Управление заказом" FontFamily="Times New Roman" FontSize="26" Foreground="Black" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel HorizontalAlignment="Center" Margin="60">

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Артикул" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbProduct" FontFamily="Times New Roman" SelectedItem="{Binding Products}" DisplayMemberPath="Article" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Статус заказа" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbStatus" FontFamily="Times New Roman" SelectedItem="{Binding OrderStatus}" DisplayMemberPath="Name" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Адрес ПВЗ" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbPVZ" FontFamily="Times New Roman" SelectedItem="{Binding PVZ}" DisplayMemberPath="Address" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Дата заказа" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Name="DpOrderDate" FontFamily="Times New Roman" SelectedDate="{Binding OrderDate}" IsEnabled="False" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Дата выдачи" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Name="DpDeliveryDate" FontFamily="Times New Roman" SelectedDate="{Binding DeliveryDate}" Width="170" Height="24"/>
            </StackPanel>

            <StackPanel Name="OrderedPanel" Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Заказчик" FontFamily="Times New Roman" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="CmbOrderer" FontFamily="Times New Roman" SelectedValue="{Binding Id_User}" SelectedValuePath="Id" DisplayMemberPath="Login" Width="170" Height="24"/>
            </StackPanel>
            <Button Content="Сохранить заказ" FontFamily="Times New Roman" Name="AddOrder" Click="AddOrder_Click"  Width="170" Height="28"  Margin="0,20,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

    </StackPanel>
</Window>
